{
  "repository": {
    "type": "git",
    "url": "https://github.com/HyeokjinKang/URLATE-v3l-backend"
  },
  "engines": {
    "node": "24",
    "pnpm": "11"
  },
  "name": "urlate-v3l-backend",
  "version": "1.0.0",
  "description": "Avoid & Get on the tempo, URLATE",
  "main": "src/",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "tsc",
    "auto-build": "tsc --watch",
    "lint": "eslint",
    "dev": "supervisor dist/index.js",
    "start": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop URLATE-v3l-backend",
    "generate-types-from-schema": "json2ts -i \"schema/*.schema.json\" -o src/types/",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "Team Croissant",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.21.0",
  "dependencies": {
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^5.11.1",
    "fs-extra": "^11.4.0",
    "google-auth-library": "^10.9.1",
    "knex": "^3.3.0",
    "mysql2": "^3.23.4",
    "node-fetch": "^3.3.2",
    "node-schedule": "^2.1.1",
    "redis": "^5.12.1",
    "signale": "^1.4.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-mysql-session": "^3.0.8",
    "@types/express-session": "^1.19.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.13.3",
    "@types/node-fetch": "^2.6.13",
    "@types/node-schedule": "^2.1.8",
    "@types/signale": "^1.4.7",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.9.6",
    "supervisor": "^0.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
