{
  "$schema": "http://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HyeokjinKang/URLATE-v3l-backend/blob/master/src/schema/config.schema.json",

  "title": "URLATE Config",
  "description": "URLATE 백엔드 서버를 구동하기 위한 설정입니다.",

  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "project", "database", "redis", "session", "google"],

  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON 스키마 지정입니다.",
      "examples": ["../schema/config.schema.json"]
    },
    "project": {
      "title": "Project",
      "description": "URLATE 자체 설정입니다.",

      "type": "object",
      "additionalProperties": false,
      "required": ["url", "api", "cdn", "game", "port", "secretKey"],

      "properties": {
        "mode": {
          "type": "string",
          "enum": ["production", "test"],
          "description": "서버 구동 모드입니다. production일 때 세션 쿠키에 secure 플래그가 적용됩니다(HTTPS 필요). 설정하지 않으면 production으로 간주합니다.",
          "examples": ["production"]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "현재 프론트 엔드 서버가 호스트되고 있는 URL입니다. 슬래시로 끝나면 안되는 것에 주의합니다.",
          "examples": ["https://example.com"]
        },
        "api": {
          "type": "string",
          "format": "uri",
          "description": "백엔드 서버가 호스트 될 URL입니다. 슬래시로 끝나면 안되는 것에 주의합니다",
          "examples": ["https://api.example.com"]
        },
        "cdn": {
          "type": "string",
          "format": "uri",
          "description": "CDN 서버가 호스트 될 URL입니다. 슬래시로 끝나면 안되는 것에 주의합니다",
          "examples": ["https://cdn.example.com"]
        },
        "game": {
          "type": "string",
          "format": "uri",
          "description": "게임 서버가 호스트 될 URL입니다. 슬래시로 끝나면 안되는 것에 주의합니다",
          "examples": ["https://game.example.com"]
        },
        "mirai": {
          "type": "string",
          "format": "uri",
          "description": "공지를 가져올 MIRAI(Docusaurus) 사이트의 URL입니다. 슬래시로 끝나면 안되는 것에 주의합니다. 설정하지 않으면 https://mirai.urlate.coupy.dev를 사용합니다.",
          "examples": ["https://mirai.urlate.coupy.dev"]
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "백엔드 서버가 열릴 포트입니다.",
          "examples": [8080]
        },
        "host": {
          "type": "string",
          "description": "백엔드 서버가 바인딩할 주소입니다. 리버스 프록시 뒤에 둔다면 127.0.0.1로 두어 포트가 외부에 직접 노출되지 않게 합니다. 설정하지 않으면 127.0.0.1에만 바인딩합니다.",
          "examples": ["127.0.0.1"]
        },
        "secretKey": {
          "type": "string"
        },
        "replayLogRetentionDays": {
          "type": "integer",
          "minimum": 0,
          "description": "플레이 리플레이 로그를 보관할 일수입니다. 0이면 로그를 남기지 않습니다. 설정하지 않으면 14일간 보관한 뒤 자동 삭제합니다.",
          "examples": [14]
        },
        "trustProxy": {
          "type": "integer",
          "minimum": 0,
          "description": "이 서버 앞에 있는 신뢰할 수 있는 프록시의 홉 수입니다. X-Forwarded-For에서 뒤로부터 이 개수만큼을 건너뛴 주소를 클라이언트 주소로 씁니다. 실제 홉 수와 정확히 맞춰야 합니다. 적으면 레이트리밋이 프록시 주소 하나에 묶이고, 많으면 클라이언트가 헤더로 주소를 위조할 수 있습니다. 설정하지 않으면 CDN + 리버스 프록시 2홉으로 간주합니다.",
          "examples": [2]
        }
      }
    },
    "database": {
      "title": "Database",
      "description": "데이터베이스 연결 설정입니다.",

      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "user", "password", "db"],

      "properties": {
        "host": {
          "type": "string",
          "format": "hostname",
          "description": "MySQL 서버 호스트입니다. 주 데이터베이스로 활용됩니다.",
          "examples": ["localhost"]
        },
        "port": {
          "type": "number",
          "description": "MySQL 저장소 포트입니다.",
          "minimum": 0,
          "maximum": 65535,
          "examples": [3306]
        },
        "user": {
          "type": "string",
          "description": "MySQL 사용자명입니다.",
          "examples": ["USERNAME"]
        },
        "password": {
          "type": "string",
          "description": "MySQL 사용자의 비밀번호입니다.",
          "examples": ["PASSWORD"]
        },
        "db": {
          "type": "string",
          "description": "MySQL에서 사용할 데이터베이스 이름입니다.",
          "examples": ["ExampleDB"]
        }
      }
    },
    "redis": {
      "title": "Redis",
      "description": "Redis 연결 설정입니다.",

      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "username", "password"],

      "properties": {
        "host": {
          "type": "string",
          "format": "hostname",
          "description": "Redis 서버 호스트입니다. 세션 저장소에 활용됩니다.",
          "examples": ["localhost"]
        },
        "port": {
          "type": "number",
          "description": "Redis 저장소 포트입니다.",
          "minimum": 0,
          "maximum": 65535,
          "examples": [6379]
        },
        "username": {
          "type": "string",
          "description": "Redis 사용자명입니다.",
          "examples": ["USERNAME"]
        },
        "password": {
          "type": "string",
          "description": "Redis 사용자의 비밀번호입니다.",
          "examples": ["PASSWORD"]
        }
      }
    },
    "session": {
      "title": "Session",
      "description": "세션 설정입니다.",

      "type": "object",
      "additionalProperties": false,
      "required": ["secret", "resave", "saveUninitialized", "domain"],

      "properties": {
        "secret": {
          "type": "string",
          "description": "세션 암호화에 사용할 시크릿 키입니다."
        },
        "resave": {
          "type": "boolean",
          "description": "세션을 언제나 세션 저장소에 다시 저장할지 여부입니다.\n변경된 점이 없더라도 다시 저장할 것이며,\n이 값을 true로 설정하는 것은 동시성 문제를 야기할 수도 있습니다.\n설정하지 않는다면 true로 설정될 것이나, 미래 버전에서 바뀔 수 있습니다.",
          "examples": [false]
        },
        "saveUninitialized": {
          "type": "boolean",
          "description": "초기화하지 않은 세션일지라도 강제로 저장할지 여부입니다.\n초기화하지 않은 세션이라 함은 새로운 세션에 값을 넣지 않았을 때를 말합니다.\nfalse로 설정한다면 서버 용량 절약이나 개인정보 보호법 준수, 동시성 문제 해소 등 이점이 많습니다.\n설정하지 않는다면 true로 설정될 것이나, 미래 버전에서 바뀔 수 있습니다.",
          "examples": [false]
        },
        "domain": {
          "type": "string",
          "description": "세션 쿠키의 도메인입니다.",
          "examples": ["example.com"]
        }
      }
    },
    "cache": {
      "title": "Cache",
      "description": "Redis 캐시 설정입니다. 생략하면 캐시가 켜진 상태로 기본 TTL이 적용됩니다.",

      "type": "object",
      "additionalProperties": false,

      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Redis 읽기 캐시 사용 여부입니다. false로 두면 모든 조회가 MySQL로 직행합니다.",
          "examples": [true]
        },
        "ttl": {
          "title": "Cache TTL",
          "description": "캐시 종류별 유효 시간(초)입니다. 지정하지 않은 항목은 기본값을 사용합니다.",

          "type": "object",
          "additionalProperties": false,

          "properties": {
            "tracks": {
              "type": "integer",
              "minimum": 1,
              "description": "곡 목록(/tracks, /track) 캐시 TTL입니다.",
              "examples": [600]
            },
            "trackInfo": {
              "type": "integer",
              "minimum": 1,
              "description": "패턴 정보(/trackInfo) 캐시 TTL입니다.",
              "examples": [600]
            },
            "teamProfile": {
              "type": "integer",
              "minimum": 1,
              "description": "팀 프로필(/teamProfile) 캐시 TTL입니다.",
              "examples": [600]
            },
            "notice": {
              "type": "integer",
              "minimum": 1,
              "description": "공지(/notice) 캐시 TTL입니다.",
              "examples": [300]
            },
            "user": {
              "type": "integer",
              "minimum": 1,
              "description": "본인 정보(/user) 캐시 TTL입니다. 설정 변경 시 즉시 무효화됩니다.",
              "examples": [300]
            },
            "authStatus": {
              "type": "integer",
              "minimum": 1,
              "description": "가입 여부(/auth/status) 캐시 TTL입니다. 가입 시 즉시 무효화됩니다.",
              "examples": [1800]
            },
            "profilePic": {
              "type": "integer",
              "minimum": 1,
              "description": "프로필 사진(/profilePic) 캐시 TTL입니다.",
              "examples": [300]
            },
            "bestRecord": {
              "type": "integer",
              "minimum": 1,
              "description": "개인 최고 기록(/record/:filename/:nickname, /bestRecords) 캐시 TTL입니다. 기록 제출 시 즉시 무효화됩니다.",
              "examples": [300]
            },
            "record": {
              "type": "integer",
              "minimum": 1,
              "description": "개별 기록(/record/:index) 캐시 TTL입니다.",
              "examples": [60]
            },
            "leaderboard": {
              "type": "integer",
              "minimum": 1,
              "description": "곡별 순위표(/records) 캐시 TTL입니다. 해당 곡 기록 제출 시 즉시 무효화됩니다.",
              "examples": [60]
            },
            "ranking": {
              "type": "integer",
              "minimum": 1,
              "description": "전체 랭킹(/ranking) 캐시 TTL입니다.",
              "examples": [60]
            },
            "profile": {
              "type": "integer",
              "minimum": 1,
              "description": "프로필(/profile) 캐시 TTL입니다.",
              "examples": [30]
            },
            "achievements": {
              "type": "integer",
              "minimum": 1,
              "description": "업적 마스터 데이터 캐시 TTL입니다.",
              "examples": [3600]
            }
          }
        }
      }
    },
    "google": {
      "title": "Google API",
      "description": "Google API 설정입니다.",

      "type": "object",
      "additionalProperties": false,
      "required": ["clientId", "clientSecret"],

      "properties": {
        "clientId": {
          "type": "string",
          "description": "Google API 클라이언트 ID입니다."
        },
        "clientSecret": {
          "type": "string",
          "description": "Google API 클라이언트 Secret Key입니다."
        }
      }
    }
  }
}
