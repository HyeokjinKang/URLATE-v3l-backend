{
  "repository": {
    "type": "git",
    "url": "https://github.com/HyeokjinKang/URLATE-v3l-backend"
  },
  "engines": {
    "node": "24",
    "pnpm": "12"
  },
  "name": "urlate-v3l-backend",
  "version": "1.0.0-rc.5",
  "description": "Avoid & Get on the tempo, URLATE",
  "main": "dist/index.js",
  "files": [
    "dist",
    "config/settings.json",
    "ecosystem.config.js",
    "LICENSE"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "tsc",
    "auto-build": "tsc --watch",
    "lint": "eslint",
    "dev": "supervisor dist/index.js",
    "start": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop URLATE-v3l-backend",
    "generate-types-from-schema": "json2ts -i \"schema/*.schema.json\" -o src/types/",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "Coupyworks",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.3.4",
  "dependencies": {
    "connect-redis": "^9.0.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^5.12.0",
    "google-auth-library": "^10.9.1",
    "knex": "^3.3.0",
    "mysql2": "^3.24.6",
    "node-schedule": "^2.1.2",
    "redis": "^5.12.1",
    "signale": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.19.2",
    "@types/node-schedule": "^2.1.8",
    "@types/signale": "^1.4.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.9.10",
    "supervisor": "^0.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
